<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Fpkg2Ftp</RootNamespace>
    <AssemblyName>fpkg2ftp</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- LibProsperoPkg 1.2.0 build d7090eb6 as patched by PS5 UltraPack (GPL-3.0-or-later). -->
    <Reference Include="LibProsperoPkg"><HintPath>lib\LibProsperoPkg.dll</HintPath></Reference>
    <!-- The versions LibProsperoPkg 1.2.0 was compiled against. -->
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.0" />
    <PackageReference Include="FluentFTP" Version="53.0.1" />
  </ItemGroup>
</Project>
